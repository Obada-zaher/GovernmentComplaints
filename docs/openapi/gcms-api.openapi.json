{
  "openapi": "3.0.3",
  "info": {
    "title": "Government Complaint Management System API",
    "version": "1.0.0",
    "description": "Laravel REST API for a Government Complaint Management System. All application endpoints are under `/api/v1` and use the shared success/error envelope. Protected endpoints require a valid Sanctum bearer token and an active account. An authenticated inactive account is rejected with `403` and `Your account is inactive.`; after administrative deactivation, revoked tokens can instead return `401` because the token no longer exists. Every endpoint accepts an optional `Accept-Language` header. `ar` and `en` are supported, including regional variants such as `ar-SY` and `en-US` and standard quality values. It affects only human-readable messages, validation text, system notification/timeline text, and Department/Category/Priority display names. IDs, codes, statuses, roles, notification types, classification method identifiers, JSON keys, nesting, and user-entered complaint content remain stable."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000/api/v1",
      "description": "Local Laravel server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    { "name": "Health" },
    { "name": "Auth" },
    { "name": "Lookups" },
    { "name": "Citizen Complaints" },
    { "name": "Admin Management" },
    { "name": "Employee Complaints" },
    { "name": "Notifications" },
    { "name": "Reports" },
    { "name": "Classification" }
  ],
  "paths": {
    "/health": { "get": { "tags": ["Health"], "security": [], "summary": "Public system health check", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/auth/register": { "post": { "tags": ["Auth"], "security": [], "summary": "Register a citizen and send OTP", "responses": { "201": { "$ref": "#/components/responses/Success" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },
    "/auth/login": { "post": { "tags": ["Auth"], "security": [], "summary": "Login with email/phone and password, then send OTP", "description": "Valid credentials start OTP verification. Valid credentials for an inactive account return `403` with message `User account is inactive.`.", "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/auth/verify-otp": { "post": { "tags": ["Auth"], "security": [], "summary": "Verify OTP and issue Sanctum token", "description": "Verifies an OTP and issues a Sanctum token only for an active account. An inactive account returns `403` and cannot receive a token.", "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },
    "/auth/resend-otp": { "post": { "tags": ["Auth"], "security": [], "summary": "Resend OTP", "description": "Sends a new OTP only for an active account. Inactive accounts cannot request or resend an OTP and receive `403`.", "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/auth/forgot-password": { "post": { "tags": ["Auth"], "security": [], "summary": "Send password reset email", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/auth/reset-password": { "post": { "tags": ["Auth"], "security": [], "summary": "Reset password", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/auth/me": { "get": { "tags": ["Auth"], "summary": "Current user", "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/auth/change-password": { "post": { "tags": ["Auth"], "summary": "Change password", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/auth/logout": { "post": { "tags": ["Auth"], "summary": "Logout current token", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/auth/logout-all": { "post": { "tags": ["Auth"], "summary": "Logout all tokens", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/lookups/departments": { "get": { "tags": ["Lookups"], "security": [], "summary": "Departments lookup", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/lookups/categories": { "get": { "tags": ["Lookups"], "security": [], "summary": "Categories lookup", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/lookups/priorities": { "get": { "tags": ["Lookups"], "security": [], "summary": "Priorities lookup", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/lookups/complaint-statuses": { "get": { "tags": ["Lookups"], "security": [], "summary": "Complaint statuses lookup", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/citizen/complaints": { "get": { "tags": ["Citizen Complaints"], "summary": "List own complaints", "parameters": [{ "name": "sort", "in": "query", "description": "Complaint ordering. Unknown values preserve newest-first ordering.", "schema": { "type": "string", "enum": ["newest", "oldest", "sla"], "default": "newest" } }], "responses": { "200": { "$ref": "#/components/responses/PaginatedSuccess" } } }, "post": { "tags": ["Citizen Complaints"], "summary": "Create complaint", "responses": { "201": { "$ref": "#/components/responses/Success" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },
    "/citizen/complaints/check-duplicates": { "post": { "tags": ["Citizen Complaints"], "summary": "Check for possible nearby duplicate complaints", "description": "Warning-only and read-only. Checks non-deleted complaints with an active status in the same category within the configured 15-meter default radius. It does not create or block a complaint, and coordinates 0,0 return no matches.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["latitude", "longitude", "category_id"], "properties": { "latitude": { "type": "number", "minimum": -90, "maximum": 90, "example": 33.5138 }, "longitude": { "type": "number", "minimum": -180, "maximum": 180, "example": 36.2765 }, "category_id": { "type": "integer", "example": 5 } } } } } }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },
    "/citizen/complaints/{complaint}": { "get": { "tags": ["Citizen Complaints"], "summary": "Show own complaint", "parameters": [{ "$ref": "#/components/parameters/ComplaintId" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/citizen/complaints/{complaint}/attachments": { "post": { "tags": ["Citizen Complaints"], "summary": "Add complaint attachments", "parameters": [{ "$ref": "#/components/parameters/ComplaintId" }], "responses": { "201": { "$ref": "#/components/responses/Success" } } } },
    "/citizen/offline/complaints/sync": { "post": { "tags": ["Citizen Complaints"], "summary": "Sync offline complaint", "responses": { "200": { "$ref": "#/components/responses/Success" }, "201": { "$ref": "#/components/responses/Success" } } } },
    "/citizen/offline/submissions": { "get": { "tags": ["Citizen Complaints"], "summary": "List offline submissions", "responses": { "200": { "$ref": "#/components/responses/PaginatedSuccess" } } } },
    "/citizen/offline/submissions/{offlineSubmission}": { "get": { "tags": ["Citizen Complaints"], "summary": "Show offline submission", "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/employee/complaints": { "get": { "tags": ["Employee Complaints"], "summary": "Employee lists assigned or department-accessible complaints", "description": "Requires `auth:sanctum`, an active account, and `role:employee`. Employees see complaints assigned directly to themselves and unassigned complaints in their own department. They cannot see complaints in another department or complaints assigned to a coworker, including one in the same department.", "responses": { "200": { "$ref": "#/components/responses/PaginatedSuccess" } } } },
    "/employee/complaints/{complaint}": { "get": { "tags": ["Employee Complaints"], "summary": "Show accessible complaint", "parameters": [{ "$ref": "#/components/parameters/ComplaintId" }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/employee/complaints/{complaint}/status": { "patch": { "tags": ["Employee Complaints"], "summary": "Update status", "parameters": [{ "$ref": "#/components/parameters/ComplaintId" }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/complaints": { "get": { "tags": ["Admin Management"], "summary": "List all complaints", "responses": { "200": { "$ref": "#/components/responses/PaginatedSuccess" } } } },
    "/admin/employees": { "get": { "tags": ["Admin Management"], "security": [{ "bearerAuth": [] }], "summary": "List government employees", "description": "Requires `auth:sanctum`, an active account, and `role:admin`. Returns only users whose role is `employee`, with their department when assigned. This employee-only lookup remains available for complaint assignment; `/admin/users` lists all roles.", "parameters": [{ "name": "search", "in": "query", "description": "Search employee name, email, or phone.", "schema": { "type": "string" } }, { "name": "department_id", "in": "query", "description": "Filter by department.", "schema": { "type": "integer" } }, { "name": "is_active", "in": "query", "description": "Filter by active status.", "schema": { "type": "boolean" } }, { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "per_page", "in": "query", "description": "Page size (maximum 100).", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 15 } }], "responses": { "200": { "$ref": "#/components/responses/PaginatedSuccess" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/admin/users": { "get": { "tags": ["Admin Management"], "security": [{ "bearerAuth": [] }], "summary": "List users", "description": "Requires `auth:sanctum`, an active account, and `role:admin`. Returns citizens, employees, and admins. `is_active` is a list filter only; use the dedicated status endpoint to change an account status.", "parameters": [{ "name": "search", "in": "query", "schema": { "type": "string" } }, { "name": "role", "in": "query", "schema": { "type": "string", "enum": ["citizen", "employee", "admin"] } }, { "name": "department_id", "in": "query", "schema": { "type": "integer" } }, { "name": "is_active", "in": "query", "schema": { "type": "boolean" } }, { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 15 } }], "responses": { "200": { "description": "Paginated safe user list.", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/UsersData" } } }] } } } }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } }, "post": { "tags": ["Admin Management"], "security": [{ "bearerAuth": [] }], "summary": "Create user", "description": "Creates a citizen, employee, or admin. An employee requires an existing active department. Citizen and admin department assignments are cleared. Passwords are accepted but never returned.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StoreUserRequest" } } } }, "responses": { "201": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },
    "/admin/users/{user}": { "get": { "tags": ["Admin Management"], "security": [{ "bearerAuth": [] }], "summary": "Show user", "parameters": [{ "name": "user", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Safe user details.", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/UserData" } } }] } } } }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } }, "patch": { "tags": ["Admin Management"], "security": [{ "bearerAuth": [] }], "summary": "Update user", "description": "Updates safe profile, role, and department fields. An employee requires an active department; citizen and admin department assignments are cleared. Account status is not editable here: supplying `is_active` returns `422`. Use `PATCH /admin/users/{user}/status` instead. An admin cannot change their own role away from admin, and the final active admin cannot be demoted.", "parameters": [{ "name": "user", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateUserRequest" } } } }, "responses": { "200": { "description": "Safe updated user.", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/UserData" } } }] } } } }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },
    "/admin/users/{user}/status": { "patch": { "tags": ["Admin Management"], "security": [{ "bearerAuth": [] }], "summary": "Activate or deactivate a user", "description": "Requires `auth:sanctum`, an active account, and `role:admin`. `is_active=false` deactivates the target and revokes every Sanctum token. `is_active=true` reactivates the target but does not restore deleted tokens, so the user must authenticate again. An admin cannot deactivate themselves and the final active admin cannot be deactivated.", "parameters": [{ "name": "user", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateUserStatusRequest" } } } }, "responses": { "200": { "description": "Safe user with updated status.", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/UserData" } } }] } } } }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },
    "/admin/complaints/{complaint}": { "get": { "tags": ["Admin Management"], "summary": "Show complaint", "parameters": [{ "$ref": "#/components/parameters/ComplaintId" }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/complaints/{complaint}/assign": { "patch": { "tags": ["Admin Management"], "summary": "Assign complaint to employee", "description": "Requires an active admin. The selected user must be an active employee with a department that matches the complaint department. A citizen, admin, inactive employee, department-less employee, cross-department employee, or complaint without a department is rejected with `422` under `assigned_employee_id`.", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ComplaintId" }], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["assigned_employee_id"], "properties": { "assigned_employee_id": { "type": "integer", "example": 2 }, "note": { "type": "string" } } } } } }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },
    "/admin/complaints/{complaint}/department": { "patch": { "tags": ["Admin Management"], "summary": "Change complaint department", "parameters": [{ "$ref": "#/components/parameters/ComplaintId" }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/complaints/{complaint}/priority": { "patch": { "tags": ["Admin Management"], "summary": "Change complaint priority", "parameters": [{ "$ref": "#/components/parameters/ComplaintId" }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/complaints/{complaint}/status": { "patch": { "tags": ["Admin Management"], "summary": "Admin update status", "parameters": [{ "$ref": "#/components/parameters/ComplaintId" }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/departments": { "get": { "tags": ["Admin Management"], "summary": "List departments", "responses": { "200": { "$ref": "#/components/responses/PaginatedSuccess" } } }, "post": { "tags": ["Admin Management"], "summary": "Create department", "responses": { "201": { "$ref": "#/components/responses/Success" } } } },
    "/admin/departments/{department}": { "get": { "tags": ["Admin Management"], "summary": "Show department", "responses": { "200": { "$ref": "#/components/responses/Success" } } }, "put": { "tags": ["Admin Management"], "summary": "Update department", "responses": { "200": { "$ref": "#/components/responses/Success" } } }, "delete": { "tags": ["Admin Management"], "summary": "Delete department", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/categories": { "get": { "tags": ["Admin Management"], "summary": "List categories", "responses": { "200": { "$ref": "#/components/responses/PaginatedSuccess" } } }, "post": { "tags": ["Admin Management"], "summary": "Create category", "responses": { "201": { "$ref": "#/components/responses/Success" } } } },
    "/admin/categories/{category}": { "get": { "tags": ["Admin Management"], "summary": "Show category", "responses": { "200": { "$ref": "#/components/responses/Success" } } }, "put": { "tags": ["Admin Management"], "summary": "Update category", "responses": { "200": { "$ref": "#/components/responses/Success" } } }, "delete": { "tags": ["Admin Management"], "summary": "Delete category", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/priorities": { "get": { "tags": ["Admin Management"], "summary": "List priorities", "responses": { "200": { "$ref": "#/components/responses/PaginatedSuccess" } } }, "post": { "tags": ["Admin Management"], "summary": "Create priority", "responses": { "201": { "$ref": "#/components/responses/Success" } } } },
    "/admin/priorities/{priority}": { "get": { "tags": ["Admin Management"], "summary": "Show priority", "responses": { "200": { "$ref": "#/components/responses/Success" } } }, "put": { "tags": ["Admin Management"], "summary": "Update priority", "responses": { "200": { "$ref": "#/components/responses/Success" } } }, "delete": { "tags": ["Admin Management"], "summary": "Delete priority", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/sla-rules": { "get": { "tags": ["Admin Management"], "summary": "List SLA rules", "responses": { "200": { "$ref": "#/components/responses/PaginatedSuccess" } } }, "post": { "tags": ["Admin Management"], "summary": "Create SLA rule", "responses": { "201": { "$ref": "#/components/responses/Success" } } } },
    "/admin/sla-rules/{sla_rule}": { "get": { "tags": ["Admin Management"], "summary": "Show SLA rule", "responses": { "200": { "$ref": "#/components/responses/Success" } } }, "put": { "tags": ["Admin Management"], "summary": "Update SLA rule", "responses": { "200": { "$ref": "#/components/responses/Success" } } }, "delete": { "tags": ["Admin Management"], "summary": "Delete SLA rule", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/notifications": { "get": { "tags": ["Notifications"], "summary": "List notifications", "responses": { "200": { "$ref": "#/components/responses/PaginatedSuccess" } } } },
    "/notifications/unread-count": { "get": { "tags": ["Notifications"], "summary": "Unread count", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/notifications/read-all": { "patch": { "tags": ["Notifications"], "summary": "Read all notifications", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/notifications/{notification}/read": { "patch": { "tags": ["Notifications"], "summary": "Read notification", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/notifications/{notification}": { "delete": { "tags": ["Notifications"], "summary": "Delete notification", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/device-tokens": { "get": { "tags": ["Notifications"], "summary": "List device tokens", "responses": { "200": { "$ref": "#/components/responses/Success" } } }, "post": { "tags": ["Notifications"], "summary": "Register device token", "responses": { "201": { "$ref": "#/components/responses/Success" } } } },
    "/device-tokens/{deviceToken}": { "delete": { "tags": ["Notifications"], "summary": "Delete device token", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/notification-preferences": { "get": { "tags": ["Notifications"], "summary": "Get preferences", "responses": { "200": { "$ref": "#/components/responses/Success" } } }, "patch": { "tags": ["Notifications"], "summary": "Update preferences", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/notification-delivery-logs": { "get": { "tags": ["Admin Management"], "summary": "List delivery logs", "responses": { "200": { "$ref": "#/components/responses/PaginatedSuccess" } } } },
    "/admin/notification-delivery-logs/{notificationDeliveryLog}": { "get": { "tags": ["Admin Management"], "summary": "Show delivery log", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/reports/overview": { "get": { "tags": ["Reports"], "summary": "Overview report", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/reports/complaints-by-status": { "get": { "tags": ["Reports"], "summary": "Complaints by status", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/reports/complaints-by-department": { "get": { "tags": ["Reports"], "summary": "Complaints by department", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/reports/complaints-by-priority": { "get": { "tags": ["Reports"], "summary": "Complaints by priority", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/reports/sla-performance": { "get": { "tags": ["Reports"], "summary": "SLA performance", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/reports/employee-performance": { "get": { "tags": ["Reports"], "summary": "Employee performance", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/reports/complaint-trends": { "get": { "tags": ["Reports"], "summary": "Complaint trends", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/reports/sla-breaches": { "get": { "tags": ["Reports"], "summary": "SLA breaches", "responses": { "200": { "$ref": "#/components/responses/PaginatedSuccess" } } } },
    "/admin/reports/snapshots": { "get": { "tags": ["Reports"], "summary": "List snapshots", "responses": { "200": { "$ref": "#/components/responses/PaginatedSuccess" } } }, "post": { "tags": ["Reports"], "summary": "Create snapshot", "responses": { "201": { "$ref": "#/components/responses/Success" } } } },
    "/admin/reports/snapshots/{reportSnapshot}": { "get": { "tags": ["Reports"], "summary": "Show snapshot", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/classification/complaints/preview": { "post": { "tags": ["Classification"], "summary": "Preview classification", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/classification-rules": { "get": { "tags": ["Classification"], "summary": "List classification rules", "responses": { "200": { "$ref": "#/components/responses/PaginatedSuccess" } } }, "post": { "tags": ["Classification"], "summary": "Create classification rule", "responses": { "201": { "$ref": "#/components/responses/Success" } } } },
    "/admin/classification-rules/{classification_rule}": { "get": { "tags": ["Classification"], "summary": "Show classification rule", "responses": { "200": { "$ref": "#/components/responses/Success" } } }, "put": { "tags": ["Classification"], "summary": "Update classification rule", "responses": { "200": { "$ref": "#/components/responses/Success" } } }, "delete": { "tags": ["Classification"], "summary": "Delete classification rule", "responses": { "200": { "$ref": "#/components/responses/Success" } } } }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum"
      }
    },
    "parameters": {
      "AcceptLanguage": {
        "name": "Accept-Language",
        "in": "header",
        "required": false,
        "description": "Optional display language for human-readable output. Supports `ar`, `en`, and regional variants such as `ar-SY` and `en-US`; defaults safely to the configured application locale.",
        "schema": { "type": "string", "example": "ar-SY,ar;q=0.9,en;q=0.8" }
      },
      "ComplaintId": {
        "name": "complaint",
        "in": "path",
        "required": true,
        "schema": { "type": "integer" }
      }
    },
    "responses": {
      "Success": {
        "description": "Success envelope",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/SuccessEnvelope" }
          }
        }
      },
      "PaginatedSuccess": {
        "description": "Success envelope with pagination metadata",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/SuccessEnvelope" }
          }
        }
      },
      "Error": {
        "description": "Error envelope",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "ValidationError": {
        "description": "Validation error envelope",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      }
    },
    "schemas": {
      "SuccessEnvelope": {
        "type": "object",
        "required": ["success", "message", "data", "meta"],
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string" },
          "data": { "type": "object" },
          "meta": { "type": "object" }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["success", "message", "errors"],
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string" },
          "errors": { "type": "object" }
        }
      },
      "DepartmentSummary": {
        "type": "object",
        "nullable": true,
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Health" },
          "code": { "type": "string", "example": "health" }
        }
      },
      "User": {
        "type": "object",
        "description": "Safe UserResource representation. Passwords, remember tokens, OTP data, and Sanctum tokens are never returned.",
        "required": ["id", "name", "email", "phone", "role"],
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Health Employee" },
          "email": { "type": "string", "format": "email", "example": "health.employee@example.com" },
          "phone": { "type": "string", "example": "0999000101" },
          "national_id": { "type": "string", "nullable": true, "example": "EMP-1001" },
          "role": { "type": "string", "enum": ["citizen", "employee", "admin"], "example": "employee" },
          "department": { "$ref": "#/components/schemas/DepartmentSummary" },
          "is_active": { "type": "boolean", "example": true },
          "phone_verified_at": { "type": "string", "format": "date-time", "nullable": true },
          "last_login_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "UserData": {
        "type": "object",
        "required": ["user"],
        "properties": { "user": { "$ref": "#/components/schemas/User" } }
      },
      "UsersData": {
        "type": "object",
        "required": ["users"],
        "properties": {
          "users": { "type": "array", "items": { "$ref": "#/components/schemas/User" } }
        }
      },
      "StoreUserRequest": {
        "type": "object",
        "required": ["name", "email", "phone", "password", "password_confirmation", "role"],
        "properties": {
          "name": { "type": "string", "maxLength": 255, "example": "Health Employee" },
          "email": { "type": "string", "format": "email", "maxLength": 255, "example": "health.employee@example.com" },
          "phone": { "type": "string", "maxLength": 255, "example": "0999000101" },
          "national_id": { "type": "string", "nullable": true, "maxLength": 255, "example": "EMP-1001" },
          "password": { "type": "string", "format": "password", "minLength": 8, "example": "password" },
          "password_confirmation": { "type": "string", "format": "password", "minLength": 8, "example": "password" },
          "role": { "type": "string", "enum": ["citizen", "employee", "admin"], "example": "employee" },
          "department_id": { "type": "integer", "nullable": true, "example": 1, "description": "Required for role employee and must reference an active department. Cleared for citizen and admin." },
          "is_active": { "type": "boolean", "default": true, "example": true }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "description": "Any subset of these safe fields may be supplied. `is_active` is intentionally prohibited; use UpdateUserStatusRequest.",
        "properties": {
          "name": { "type": "string", "maxLength": 255, "example": "Updated Employee" },
          "email": { "type": "string", "format": "email", "maxLength": 255 },
          "phone": { "type": "string", "maxLength": 255 },
          "national_id": { "type": "string", "nullable": true, "maxLength": 255 },
          "role": { "type": "string", "enum": ["citizen", "employee", "admin"] },
          "department_id": { "type": "integer", "nullable": true, "description": "Required with an active department for employees; cleared for citizens and admins." }
        }
      },
      "UpdateUserStatusRequest": {
        "type": "object",
        "required": ["is_active"],
        "properties": { "is_active": { "type": "boolean", "example": false } }
      }
    }
  }
}
